# Rust build artifacts
/target

# OS / editor cruft
Thumbs.db
Desktop.ini
*.rs.bk

# Player-specific state written by the game at runtime (notes, battle stats — `.glg` is the
# game-generated format). Narrative lives in the tracked `.brf` templates under
# assets/levels/; progress (mi_progress.json) and config (mi_controls.cfg) sit next to the
# exe under /target — never tracked.
/assets/notes/

# The compiled game and its debug symbols stay out of git (owner, 2026-07-08: binaries are
# distributed via releases, not the repo); build.cmd / build.sh produce the root game.exe
# locally. The player state the game writes next to itself stays out too.
/game.exe
/game.pdb
/mi_progress.json
/mi_controls.cfg
/mi_notes.txt

# The dev shortcut the build script drops at the root (machine-specific absolute target)
/game-dev.lnk

# Internal development docs (the authoritative CHANGELOG, the design archive) stay local —
# the repo ships the game, not the process (owner, 2026-07-08). The current, public-facing
# docs the README links to ARE tracked: they are the negated exceptions below.
/docs/*
!/docs/gameplay.md
!/docs/architecture.md
!/docs/simulation.md

# Release packaging output
/dist/

# The staged wasm binary (rebuilt by package-web.cmd; the shell files ARE tracked)
/web/game.wasm
# Player-local replay files (the recorder writes these next to the exe)
mi_replays/
replays/
# The replay-upload shared key (baked into builds at package time; never committed)
infra/upload-key.local.txt
shots/
