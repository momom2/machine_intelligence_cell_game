# Mission 7 — Far Far Away.
# PLACEHOLDER briefing.

[level]
arc       = 1
index     = 5
id        = 7
title     = Far Far Away
blurb     = PLACEHOLDER
objective = PLACEHOLDER
hint      = PLACEHOLDER
hint      = PLACEHOLDER
hint      = PLACEHOLDER
hint      = PLACEHOLDER
# The ADJACENT Simple: targets AND funding legs only within range of owned ground — it
# crawls around the ring, never across the middle. Range sits between the 60° neighbour
# chord (72) and the skip-one chord (~120).
enemy      = simple_adjacent 90 v1
enemy      = passive
horizon    = 4800
zoom_start = 2.5
zoom_min   = 0.3
# Open centred on the player shipyard (the orbit centre), not the map centroid (which the
# far-away reinforcement subs would pull off to the east).
look_at    = 0 0

# The PLAYER-OWNED shipyard dead centre, starting empty (active token bar): its output
# pools under the watchers' guns. Static; the field turns around it. 
# (Plain subs go before the rings.)
[sub]
pos   = 0 0
kind  = shipyard
owner = player

# Reinforcements from far away.
[sub]
pos   = 250+-5 0
kind  = shipyard
owner = enemy
ships = 0

[sub]
pos   = 270+-2 0
kind  = teleporter
owner = enemy2
ships = 300

# The outer ring: seven 90/3 subs spaced regularly, revolving slowly. East = enemy
# beachhead, west (180°) = player, the rest neutral.
[orbit]
center = 0 0
radius = 72
period = -2200
subs   = 7

[sub]
owner = enemy
cap   = 90
prod  = 3
ships = 60

[sub]
owner = enemy
cap   = 90
prod  = 3
ships = 60

[sub]
owner = neutral
cap   = 90
prod  = 3

[sub]
owner = neutral
cap   = 90
prod  = 3

[sub]
owner = player
cap   = 90
prod  = 3
ships = 90

[sub]
owner = neutral
cap   = 90
prod  = 3

[sub]
owner = neutral
cap   = 90
prod  = 3

# The watchers: three Passive-seat fortresses on the slow counter-rotating inner ring,
# manned 30 each — their zones (reach ~21.7) cover the yard from every bearing.
[orbit]
center = 0 0
radius = 19
period = 2700
subs   = 3

[sub]
angle = 90
kind  = fortress
owner = enemy2
ships = 30

[sub]
angle = 210
kind  = fortress
owner = enemy2
ships = 30

[sub]
angle = 330
kind  = fortress
owner = enemy2
ships = 30

