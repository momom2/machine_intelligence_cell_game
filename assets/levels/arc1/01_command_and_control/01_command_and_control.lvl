# Mission 3 — Command and Control. Tactics tutorial.
# and ai::cycler for the enemy's full behaviour. PLACEHOLDER briefing copy.

[level]
arc       = 1
index     = 1
id        = 3
title     = Command and Control
blurb     = The adversary drills. It rotates its ships between its subs, masses when attacked, and strikes only with crushing force.
objective = Eliminate the Cycler before its muster becomes a strike.
hint      = Watch for the muster: when its ships gather on one sub, a strike is coming.
hint      = Its rotating column dodges idle attrition, so waiting favours the enemy. The clock is against you.
hint      = Attack a sub it cannot reinforce in time, and hold what you take: a returning defender heals the capture bar.
hint      = Ships already on the ground it does not own fight on their own. Do not feed them.
enemy     = cycler
horizon   = 2400


# Player pair, west.
[sub]
pos   = -28 14
owner = player
cap   = 60
prod  = 2
ships = 60

[sub]
pos   = -28 -14
owner = player
cap   = 60
prod  = 2
ships = 60

# Enemy pair, east — the Cycler's drill ground.
[sub]
pos   = 28 14
owner = enemy
cap   = 60
prod  = 2
ships = 50

[sub]
pos   = 28 -14
owner = enemy
cap   = 60
prod  = 2
ships = 50
