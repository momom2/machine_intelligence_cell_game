# Arc 1 · Level 0 — placeholder (reserved; real content later). Marked `playable = false`, so
# level-select shows it locked/greyed and never enters it, and the unlock chain skips over it to
# Arc 1 · Level 1. A trivial valid board keeps the determinism / --selftest gates satisfied.

[level]
