# Mission 7 — Far Far Away.
# PLACEHOLDER briefing.

[level]
id        = 7
title     = Far Far Away
blurb     = PLACEHOLDER
objective = PLACEHOLDER
hint      = PLACEHOLDER
hint      = PLACEHOLDER
hint      = PLACEHOLDER
hint      = PLACEHOLDER
# The ADJACENT Simple: targets AND funding legs only within range of owned ground — it
# crawls around the ring, never across the middle. Range sits between the 60° neighbour
# chord (72) and the skip-one chord (~120).
enemy      = simple_adjacent 90
enemy      = passive
start      = layer1 0
horizon    = 4800
zoom_start = 2.5


# --- The contested struct (unnamed). --------------------------------------------------
[struct]
pos = 0 0
zoom_min  = 1.5
storage_scale = 0.6

# The PLAYER-OWNED shipyard dead centre, starting empty (active token bar): its output
# pools under the watchers' guns. Static; the field turns around it. 
# (Plain subs go before the rings.)
[sub]
pos   = 0 0
kind  = shipyard
owner = player

# The outer ring: seven 90/3 subs spaced regularly, one clockwise revolution per 1500 reference ticks. East = enemy
# beachhead, west (180°) = player, the rest neutral.
[orbit]
center = 0 0
radius = 72
period = -2200

[sub]
owner = enemy
cap   = 90
prod  = 3
ships = 60

[sub]
owner = enemy
cap   = 90
prod  = 3
ships = 60

[sub]
owner = neutral
cap   = 90
prod  = 3

[sub]
owner = neutral
cap   = 90
prod  = 3

[sub]
owner = player
cap   = 90
prod  = 3
ships = 90

[sub]
owner = neutral
cap   = 90
prod  = 3

[sub]
owner = neutral
cap   = 90
prod  = 3

# The watchers: three Passive-seat fortresses on the slow counter-rotating inner ring,
# manned 30 each — their zones (reach ~21.7) cover the yard from every bearing.
[orbit]
center = 0 0
radius = 19
period = 2700

[sub]
angle = 90
kind  = fortress
owner = enemy2
ships = 30

[sub]
angle = 210
kind  = fortress
owner = enemy2
ships = 30

[sub]
angle = 330
kind  = fortress
owner = enemy2
ships = 30

# --- The enemy struct (far away): a single active shipyard — the source. ------
[struct]
pos = 170 0
# Per-struct out-zoom floor: the lone-yard fit is a giant close-up; this lets the wheel pull
# back far enough to see the whole reserve ring before the transition to Layer 2.
zoom_max = 1.3
zoom_min = 0.3

[sub]
pos   = 0 0
kind  = shipyard
owner = enemy
ships = 0

[lane]
between = 0 1
length  = 170
