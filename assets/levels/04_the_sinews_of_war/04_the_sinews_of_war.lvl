prod  = 1

# The wall: three mutually covering fortresses (20 apart, reach ~21.7). Only the MIDDLE
# starts enemy at full capacity; top/bottom are neutral and EMPTY (claimable — a manned
# outer fort reaches into the middle fort's own ground).
[sub]
pos   = 0 22
kind  = fortress
owner = neutral

[sub]
pos   = 0 0
kind  = fortress
owner = enemy
ships = 90

[sub]
pos   = 0 -22
kind  = fortress
owner = neutral

