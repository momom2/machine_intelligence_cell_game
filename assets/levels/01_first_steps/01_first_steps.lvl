# Mission 1 — First Steps. Movement tutorial.

[level]
id        = 1
title     = First Steps
blurb     = PLAHOLDER
objective = Showcase that your access to the simulation's ActionTools is functional by using them to eliminate the enemy.
hint      = Left-click your home sub-structure to select it.
hint      = Left-click a destination to send ships from the selection to it.
hint      = Ships capture an unguarded site on arrival.
hint      = Production squares produce ships at regular intervals.
enemy     = passive
horizon   = 1200


# Centre: a passive Enemy garrison — big and deeply stocked. Its surplus STAYS HOME
# (owner QoL): a passive keep must not leak spawns onto the player's staging ring.
[sub]
pos          = 0 0
owner        = enemy
cap          = 90
prod         = 3
ships        = 400

# Four corners of a wide square: one Player home, three neutral. The outer edges stay
# out of the centre's reach, so the player expands corner-to-corner before striking.
[sub]
pos   = -40 -40
owner = player
cap   = 60
prod  = 2
ships = 100

[sub]
pos   = 40 -40
owner = neutral
cap   = 60
prod  = 2

[sub]
pos   = 40 40
owner = neutral
cap   = 60
prod  = 2

[sub]
pos   = -40 40
owner = neutral
cap   = 60
prod  = 2
