# Mission 7 — Far far away (the orbiting contested field + the unseen source).
# Both structs are UNNAMED and the camera opens INSIDE the contested struct: the discovery
# that the sandbox is bigger than the box IS the mission. PLACEHOLDER diegetic briefing —
# no mention of layers or lenses anywhere.

[level]
id        = 7
title     = Far far away
blurb     = A turning field: every post rides its orbit, a dead foundry waits at the hub, and the watchers on the inner ring answer to no one. The enemy never seems to run out of ships. Where do they keep coming from?
objective = Eliminate all hostiles — take the turning field, silence the watchers, and cut the enemy off at the source.
hint      = The ground itself moves. Your ships lead a moving target — launch and trust the intercept.
hint      = The watchers fire on everyone in reach, and the foundry never leaves their kill zone. They must fall before it can be worked.
hint      = Count their ships. Count yours. The arithmetic doesn't close — their reinforcements come from somewhere beyond the field.
hint      = Follow the arrows at the edge of the screen. Zoom out. Farther.
# The ADJACENT Simple: targets AND funding legs only within range of owned ground — it
# crawls around the ring, never across the middle. Range sits between the 60° neighbour
# chord (72.58) and the skip-one chord (~125.7).
enemy     = simple_adjacent 100
enemy     = passive
start     = layer1 0
horizon   = 4800
zoom_min  = 0.8

# --- The contested struct (unnamed). --------------------------------------------------
# (The reserve runs at the DEFAULT scale — the old in-code 0.6 comment was stale; the code
# always shipped the default. Add `storage_scale = 0.6` here to tighten it, no recompile.)
[struct]
pos = 0 0

# Six 90/3 subs 60° apart (R = 72.576), all orbiting the centre clockwise (one revolution
# per 1500 reference ticks). East = enemy beachhead, west = player, the rest neutral.
[sub]
pos   = 72.576 0
owner = enemy
cap   = 90
prod  = 3
ships = 90
orbit = 0 0 -1500

[sub]
pos   = 36.288 62.8534
owner = neutral
cap   = 90
prod  = 3
orbit = 0 0 -1500

[sub]
pos   = -36.288 62.8534
owner = neutral
cap   = 90
prod  = 3
orbit = 0 0 -1500

[sub]
pos   = -72.576 0
owner = player
cap   = 90
prod  = 3
ships = 90
orbit = 0 0 -1500

[sub]
pos   = -36.288 -62.8534
owner = neutral
cap   = 90
prod  = 3
orbit = 0 0 -1500

[sub]
pos   = 36.288 -62.8534
owner = neutral
cap   = 90
prod  = 3
orbit = 0 0 -1500

# The ENEMY-OWNED shipyard dead centre, starting empty (active token bar): its output
# pools under the watchers' guns — the enemy owns the middle, but the middle answers
# to no one. Static; the field turns around it.
[sub]
pos   = 0 0
kind  = shipyard
owner = enemy

# The watchers: three Passive-seat fortresses on the slow counter-rotating inner ring
# (R = 18.2, one revolution per 3000 reference ticks), manned 30 each — their zones
# (reach ~21.7) cover the yard from every bearing.
[sub]
pos   = 0 18.2
kind  = fortress
owner = enemy2
ships = 30
orbit = 0 0 3000

[sub]
pos   = -15.7617 -9.1
kind  = fortress
owner = enemy2
ships = 30
orbit = 0 0 3000

[sub]
pos   = 15.7617 -9.1
kind  = fortress
owner = enemy2
ships = 30
orbit = 0 0 3000

# --- The enemy struct (unnamed, far away): a single active shipyard — the source. ------
[struct]
pos = 170 0

[sub]
pos   = 0 0
kind  = shipyard
owner = enemy
ships = 40

[lane]
between = 0 1
length  = 170
